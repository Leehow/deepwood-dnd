  "dungeon_design_tips": {
    "description": "地下城设计建议",
    "tips": [
      {
        "tip": "使用非对称的布局",
        "reason": "避免地下城显得单调乏味"
      },
      {
        "tip": "从三维空间的角度进行思考",
        "reason": "楼梯、斜坡、平台、凸台、阳台、陷坑等高差地形让地下城更有趣"
      },
      {
        "tip": "给地下城布置一些损毁的场景",
        "reason": "倒塌的通道、地震裂谷可以作为障碍增加趣味"
      },
      {
        "tip": "在建筑内布置一些自然特征物",
        "reason": "比如一条地下河贯穿矮人要塞"
      },
      {
        "tip": "加入复数的出入口",
        "reason": "让玩家冒险时作出更多选择"
      },
      {
        "tip": "加入密门和密室",
        "reason": "奖励积极搜索的玩家"
      }
    ]
  }
