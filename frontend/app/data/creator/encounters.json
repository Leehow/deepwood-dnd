      },
      {
        "name": "打倒某个单一目标",
        "name_en": "Take Out a Single Target",
        "description": "反派被强大到足以杀死冒险者们的手下们簇拥着。角色们必须想办法攻击目标。",
        "complications": ["手下可能是无辜的被控制者"],
        "type": "combat"
      }
