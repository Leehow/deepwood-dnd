  "moral_quandaries": {
    "description": "道义困境 - 没有施法或剑击的危机",
    "dice": "d20",
    "items": [
      {
        "roll": [1, 3],
        "type": "结盟困境",
        "typeEn": "Ally Quandary",
        "description": "冒险者们在两个独立个体的帮助下可以更好的达成目的，而他们各自的专业水平都几乎必不可少。然而这两个NPC互相憎恨，即使世界的命运悬而未决他们也拒绝合作。",
        "dilemma": "冒险者们必须选择最有可能帮助到自己的NPC"
      },
      {
        "roll": [4, 6],
        "type": "友谊困境",
        "typeEn": "Friend Quandary",
        "description": "一名或多名角色所关心的一位NPC对角色提出一项不可能达到的要求。",
        "examples": [
          "一位爱慕者要求角色远离某项危险的任务",
          "一个好朋友恳求角色饶过反派的性命",
          "一个软弱的NPC为了重新获得大家的青睐，挺身承担一项危险的任务"
        ]
      },
      {
        "roll": [7, 12],
        "type": "荣誉困境",
        "typeEn": "Honor Quandary",
        "description": "角色必须在个人荣誉和更大的利益之间做出选择",
        "examples": [
          "遵守一个不利的承诺",
          "保护一个不值得保护的人",
          "执行一个不公正的命令"
        ]
      },
      {
        "roll": [13, 16],
        "type": "救援困境",
        "typeEn": "Rescue Quandary",
        "description": "冒险者们必须在抓捕或杀伤反派和拯救无辜生命之间作出选择。",
        "example": "冒险者们发现反派正在附近扎营，同时还知道反派势力的另一部分即将进军一个村庄准备将其烧成废土。角色们必须选择制服反派或保护无辜村民。"
      },
      {
        "roll": [17, 20],
        "type": "认同困境",
        "typeEn": "Respect Quandary",
        "description": "两个重要盟友向冒险者们提供了相互冲突的指引或建议。",
        "example": "高阶祭司建议角色与附近森林里的军事化精灵群体进行和平谈判，而一位资深武士则敦促他们以一次果敢的突袭来彰显自己的力量。无论选择哪一方，必定会失去另一方的认同。"
      }
    ]
  },
