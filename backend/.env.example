# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dnd_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:5174", "http://localhost:3000"]

# AI API (Default - can be overridden by user settings)
DEFAULT_AI_API_URL=https://api.openai.com/v1
DEFAULT_AI_API_KEY=your-api-key-here

# MinerU OCR
MINERU_API_KEY=your-mineru-api-key
MINERU_API_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=pipeline
MINERU_LANGUAGE=ch

# Doc2X OCR
DOC2X_API_KEY=your-doc2x-api-key
DOC2X_API_URL=https://v2.doc2x.noedgeai.com/

# Mistral OCR (legacy fallback)
MISTRAL_API_KEY=
MISTRAL_API_URL=https://api.mistral.ai/v1

# WebSocket
WS_HEARTBEAT_INTERVAL=30
